# Copy this file to .env and fill local Dataverse connection values.
# .env is ignored by git. Do not commit real credentials.

DEVKIT_AUTH_TYPE=ClientSecret
DEVKIT_URL=https://<environment>.crm.dynamics.com
DEVKIT_CLIENT_ID=<client-id>
DEVKIT_CLIENT_SECRET=<client-secret>

# Optional when using DEVKIT_AUTH_TYPE=FromPac.
# DEVKIT_PAC_PROFILE=<pac-profile>
